# This is a sample configuration file. You can generate your configuration
# with the `bundle exec rails mastodon:setup` interactive setup wizard, but to customize
# your setup even further, you'll need to edit it manually. This sample does
# not demonstrate all available configuration options. Please look at
# https://docs.joinmastodon.org/admin/config/ for the full documentation.

# Note that this file accepts slightly different syntax depending on whether
# you are using `docker-compose` or not. In particular, if you use
# `docker-compose`, the value of each declared variable will be taken verbatim,
# including surrounding quotes.
# See: https://github.com/mastodon/mastodon/issues/16895

# Federation
# ----------
# This identifies your server and cannot be changed safely later
# ----------
LOCAL_DOMAIN=example.com

# Redis
# -----
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL
# ----------
DB_HOST=/var/run/postgresql
DB_USER=mastodon
DB_NAME=mastodon_production
DB_PASS=
DB_PORT=5432

# Elasticsearch (optional)
# ------------------------
ES_ENABLED=true
ES_HOST=localhost
ES_PORT=9200
# Authentication for ES (optional)
ES_USER=elastic
ES_PASS=password

# Secrets
# -------
# Make sure to use `bundle exec rails secret` to generate secrets
# -------
SECRET_KEY_BASE=

# Encryption secrets
# ------------------
# Must be available (and set to same values) for all server processes
# These are private/secret values, do not share outside hosting environment
# Use `bin/rails db:encryption:init` to generate fresh secrets
# Do NOT change these secrets once in use, as this would cause data loss and other issues
# ------------------
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=

# Web Push
# --------
# Generate with `bundle exec rails mastodon:webpush:generate_vapid_key`
# --------
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=

# Sending mail
# ------------
SMTP_SERVER=
SMTP_PORT=587
SMTP_LOGIN=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=notifications@example.com

# File storage (optional)
# -----------------------
S3_ENABLED=true
S3_BUCKET=files.example.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ALIAS_HOST=files.example.com

# Optional list of hosts that are allowed to serve media for your instance
# EXTRA_MEDIA_HOSTS=https://data.example1.com,https://data.example2.com

# IP and session retention
# -----------------------
# Make sure to modify the scheduling of ip_cleanup_scheduler in config/sidekiq.yml
# to be less than daily if you lower IP_RETENTION_PERIOD below two days (172800).
# -----------------------
IP_RETENTION_PERIOD=31556952
SESSION_RETENTION_PERIOD=31556952

AUTHORIZED_FETCH=true
LIMITED_FEDERATION_MODE=true
DISALLOW_UNAUTHENTICATED_API_ACCESS=true

# API 요청 한도는 환경 변수로 바꿀 수 없다 — config/initializers/rack_attack.rb 의 고정값이다.

# Post counting
# -------------
# Whether direct messages count towards the post number shown on a profile.
# Off by default: a DM is a conversation, not something posted to a profile.
# `tootctl cache recount statuses` already counts it this way, so changing this
# means running that afterwards to bring existing accounts back in line.
COUNT_DIRECT_STATUSES=false

# Scheduled posts
# ---------------
# Maximum number of scheduled posts an account may hold at once (default: 300)
SCHEDULED_STATUS_TOTAL_LIMIT=300

# Maximum number of posts an account may schedule for a single day (default: 25)
# Counted by UTC date, so a generous value avoids surprises for users in other
# time zones.
SCHEDULED_STATUS_DAILY_LIMIT=25

# Smallest allowed distance between "now" and the publication time, in seconds
# (default: 60). Kept non-zero so the time cannot lapse while the user is
# confirming the dialog.
SCHEDULED_STATUS_MINIMUM_OFFSET=60

# DM chat
# -------
# Master switch for the DM chat UI (/messages) and its API.
#
# The code default is OFF, so an existing server that pulls this release does
# not suddenly grow a new screen. Set it to `true` to turn the feature on.
# While off, /messages redirects to /conversations and every /api/v1/dm_rooms*
# endpoint returns 404 (not 403 — a 403 would confirm the route exists).
#
# Read at call time, not frozen into a constant: lib/ is required before dotenv
# loads this file, so a constant would freeze to `false` no matter what is set
# here. See docs/dm-chat/ops/dm-chat-development.md §1.1 if it refuses to turn on.
DM_CHAT_ENABLED=true

# Upper bound on the account_conversations.status_ids array (default: 100).
# Without a bound, every new DM re-sorts and rewrites the whole array.
# `0` means unlimited — the pre-patch behaviour, kept as a rollback switch that
# needs no deploy. Run `dm:rebuild_status_ids` after raising or removing it.
# A value that will not parse as an integer falls back to 100 rather than to
# unlimited: a typo must not silently undo the bound.
STATUS_IDS_LIMIT=100

# DM send limit, in messages per period (default: 1000, minimum 1).
# DMs live in their own rate-limit family. The public-post limit (300 per 3
# hours) is untouched — chat traffic would otherwise exhaust it in minutes.
DM_RATE_LIMIT=1000

# Period for the limit above, in seconds (default: 3600, minimum 60).
DM_RATE_LIMIT_PERIOD=3600

# Multi-Account Switcher
# ----------------------
# OAuth client credentials for multi-account functionality
# Generate client_id with: SecureRandom.uuid
# Generate client_secret with: bundle exec rails secret
# ----------------------
MA_MULTI_ACCOUNT_CLIENT_ID=
MA_MULTI_ACCOUNT_CLIENT_SECRET=
MA_MULTI_ACCOUNT_REDIRECT_URI=

# 아래는 비워 두면 괄호 안의 기본값이다.
# 계정 전환 토큰 갱신 흐름. false 면 계정 전환이 꺼진다 (기본 true)
MA_MULTI_ACCOUNT_REFRESH_FLOW=true
# 비밀번호 변경 등으로 토큰을 모두 폐기할 때도 계정 전환 토큰은 남긴다 — 결정 A (기본 true)
MA_MULTI_ACCOUNT_RETAIN_TOKENS=true
# 계정 전환 앱이 받는 권한 (기본 read write follow push)
MA_MULTI_ACCOUNT_SCOPES=read write follow push
# 계정 전환(세션 갱신)을 허용할 사용자 비율, 0~100 (기본 100)
MA_ROLLOUT_PERCENTAGE=100
# 비율과 무관하게 늘 켤 사용자 id, 쉼표로 구분 (기본 없음)
MA_INTERNAL_USER_IDS=

# 앱 푸시(FCM)
# ------------
# Firebase 서비스 계정 키 파일 경로 (기본 config/fcm_service_account.json). config/fcm.yml 참고.
# 기본 위치를 쓰면 이 줄을 주석으로 둔다 — 빈 값으로 두면 기본값 대신 빈 경로가 된다.
# FCM_SERVICE_ACCOUNT_PATH=/home/mastodon/fcm_service_account.json

# 메일
# ----
# 가입 확인·환영 메일의 '마스토돈 가이드' 단추 주소 (기본: app/mailers/user_mailer.rb 의 DEFAULT_GUIDE_URL)
LONGWHILE_GUIDE_URL=

# Email subscriptions (4.6+)
# --------------------------
# Lets people subscribe to an account's public posts by email. Off here: this
# instance does not federate and keeps posts to followers (docs/upgrade/DEPLOY.md S3).
DISABLE_EMAIL_SUBSCRIPTIONS=true

# Software update check
# ---------------------
# Keep empty. The version string is "x.y.z-longwhile", which the update check reads
# as a pre-release of x.y.z, so the matching upstream release would stay flagged
# as a pending (often urgent) update forever. `mastodon:setup` writes it empty.
UPDATE_CHECK_URL=
