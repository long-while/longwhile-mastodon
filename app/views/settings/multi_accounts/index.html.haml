- content_for :page_title do
  = t('multi_accounts.title')

- if @tokens.any? && !current_account.suspended?
  - content_for :heading_actions do
    = link_to t('multi_accounts.revoke_all'),
              destroy_all_settings_multi_accounts_path,
              class: 'button button--destructive',
              method: :delete,
              data: { confirm: t('multi_accounts.revoke_all_confirm') }

%p.muted-hint= t('multi_accounts.description')

%hr.spacer/

- if @tokens.empty?
  .muted-hint.center-text= t('multi_accounts.empty')
- else
  .table-wrapper
    %table.table.inline-table
      %thead
        %tr
          %th= t('multi_accounts.issued_at')
          %th= t('multi_accounts.last_used')
          %th= t('multi_accounts.ip')
          %th
      %tbody
        - @tokens.each do |token|
          %tr
            %td
              %time.formatted{ datetime: token.created_at.iso8601 }= l(token.created_at)
            %td
              - if token.last_used_at
                %time.time-ago{ datetime: token.last_used_at.iso8601, title: l(token.last_used_at) }= l(token.last_used_at)
              - else
                = t('multi_accounts.never_used')
            %td
              - if token.last_used_ip
                %samp= token.last_used_ip
            %td
              - unless current_account.suspended?
                = table_link_to 'close',
                                t('multi_accounts.revoke'),
                                settings_multi_account_path(token),
                                method: :delete,
                                data: { confirm: t('multi_accounts.revoke_confirm') }
