- content_for :page_title do
  = t('admin.settings.branding.title')

- content_for :heading do
  = render partial: 'admin/settings/shared/heading'

= simple_form_for @admin_settings, url: admin_settings_branding_path, html: { id: 'edit_admin_settings', method: :patch } do |f|
  = render 'shared/error_messages', object: @admin_settings

  .fields-group
    = f.input :site_title,
              hint: false,
              wrapper: :with_label

  .fields-row
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :site_contact_username,
                hint: false,
                wrapper: :with_label
    .fields-row__column.fields-row__column-6.fields-group
      = f.input :site_contact_email,
                hint: false,
                wrapper: :with_label

  .fields-group
    = f.input :site_short_description,
              as: :text,
              hint: false,
              input_html: { rows: 2, maxlength: Form::AdminSettings::DESCRIPTION_LIMIT },
              wrapper: :with_block_label

  = render 'admin/settings/branding/guide'

  .image-picker
    = render partial: 'admin/settings/shared/upload', locals: { f: f, attribute: :thumbnail, upload: @admin_settings.thumbnail, frame: 'thumbnail' }
    = render partial: 'admin/settings/shared/upload', locals: { f: f, attribute: :favicon, upload: @admin_settings.favicon }
    = render partial: 'admin/settings/shared/upload', locals: { f: f, attribute: :app_icon, upload: @admin_settings.app_icon }

  .branding-wordmark
    %h4.branding-wordmark__title= t('admin.settings.uploads.guide.wordmark.name')
    %p.image-picker__size= t('admin.settings.uploads.sizes.wordmark')
    .branding-wordmark__rules
      %p= t('admin.settings.uploads.wordmark_rules.format')
      %p= t('admin.settings.uploads.wordmark_rules.themes')
      %p= t('admin.settings.uploads.wordmark_rules.tone')
      %p= t('admin.settings.uploads.wordmark_rules.margin')
      %p= t('admin.settings.uploads.wordmark_rules.center')

    .image-picker.branding-wordmark__pair
      - SiteUpload::WORDMARK_VARS.each do |var|
        = render partial: 'admin/settings/shared/upload', locals: { f: f, attribute: var.to_sym, upload: @admin_settings.public_send(var), frame: var.dasherize, size: :wordmark, show_size: false, accept: SiteUpload::WORDMARK_MIME_TYPES, input_data: wordmark_input_data, extra: 'admin/settings/branding/wordmark_extra' }

    %h5.branding-wordmark__subtitle= t('admin.settings.uploads.wordmark_preview')
    .branding-wordmark__pair
      - SiteUpload::WORDMARK_VARS.each do |var|
        = render 'admin/settings/branding/wordmark_preview', attribute: var.to_sym, upload: @admin_settings.public_send(var)
