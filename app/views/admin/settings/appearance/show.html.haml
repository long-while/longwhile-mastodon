- content_for :page_title do
  = t('admin.settings.appearance.title')

- content_for :heading do
  = render partial: 'admin/settings/shared/heading'

= simple_form_for @admin_settings, url: admin_settings_appearance_path, html: { id: 'edit_admin_settings', method: :patch } do |f|
  = render 'shared/error_messages', object: @admin_settings

  .fields-group
    = f.input :theme,
              hint: false,
              collection: Themes.instance.names,
              include_blank: false,
              label_method: ->(theme) { I18n.t("themes.#{theme}", default: theme) },
              wrapper: :with_label

  .fields-group
    = f.input :custom_css,
              as: :text,
              hint: false,
              input_html: { rows: 8 },
              wrapper: :with_block_label

  .image-picker
    = render partial: 'admin/settings/shared/upload', locals: { f: f, attribute: :mascot, upload: @admin_settings.mascot, preview_url: (@admin_settings.mascot.file.url if @admin_settings.mascot.persisted?) }
