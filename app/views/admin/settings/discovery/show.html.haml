- content_for :page_title do
  = t('admin.settings.discovery.title')

- content_for :heading do
  = render partial: 'admin/settings/shared/heading'

= simple_form_for @admin_settings, url: admin_settings_discovery_path, html: { id: 'edit_admin_settings', method: :patch } do |f|
  = render 'shared/error_messages', object: @admin_settings

  .fields-group
    = f.input :timeline_preview,
              as: :boolean,
              hint: false,
              wrapper: :with_label

    = f.input :noindex,
              as: :boolean,
              hint: false,
              label: t('admin.settings.default_noindex.title'),
              wrapper: :with_label

    = f.input :trends,
              as: :boolean,
              hint: false,
              wrapper: :with_label
