- content_for :page_title do
  = t('admin.settings.about.title')

- content_for :heading do
  = render partial: 'admin/settings/shared/heading'

= simple_form_for @admin_settings, url: admin_settings_about_path, html: { id: 'edit_admin_settings', method: :patch } do |f|
  = render 'shared/error_messages', object: @admin_settings

  .fields-group
    = f.input :site_extended_description,
              as: :text,
              hint: false,
              input_html: { rows: 8 },
              wrapper: :with_block_label

  .fields-group
    = f.input :site_terms,
              as: :text,
              hint: false,
              input_html: { rows: 8 },
              wrapper: :with_block_label
