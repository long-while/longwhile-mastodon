- content_for :page_title do
  = t('admin.settings.content_retention.title')

- content_for :heading do
  = render partial: 'admin/settings/shared/heading'

= simple_form_for @admin_settings, url: admin_settings_content_retention_path, html: { id: 'edit_admin_settings', method: :patch } do |f|
  = render 'shared/error_messages', object: @admin_settings

  .fields-group
    = f.input :backups_retention_period,
              hint: false,
              input_html: { pattern: '[0-9]+' },
              wrapper: :with_block_label
