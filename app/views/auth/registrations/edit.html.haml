- content_for :page_title do
  = t('settings.account_settings')

-# @_longwhile — 저장을 제목 옆으로 올렸다. 이 화면에는 폼이 하나(로그인)뿐이고
-# 나머지는 링크 묶음이라, 아래 길쭉한 단추가 무엇을 저장하는지 오히려 흐렸다.
- content_for :heading_actions do
  = button_tag t('generic.save_changes'), class: 'button', form: 'edit_account', disabled: current_account.suspended?

- if self_destruct?
  .flash-message.warning
    = t('auth.status.self_destruct', domain: Rails.configuration.x.local_domain)
- else
  = render partial: 'status', locals: { user: @user, strikes: @strikes }

-# @_longwhile — 계정 화면을 소제목 셋(로그인 · 보안 · 내 데이터)으로 다시 짰다.
-# 본문의 작은 링크로만 닿던 것들(로그인 기록 · 계정 삭제)과 사이드바에만
-# 있던 것들(2단계 인증 · 연결된 앱 · 오래된 게시물 자동 삭제 · 데이터 내려받기)을
-# 한 화면에서 보이게 모았다 (settings-phase-4.md §2).
%h3= t('auth.login')

= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { id: 'edit_account', method: :put, class: 'auth_edit', novalidate: false }) do |f|
  = render 'shared/error_messages', object: resource

  - if (!use_seamless_external_login? || resource.encrypted_password.present?) && !omniauth_only?
    .fields-row
      .fields-row__column.fields-group.fields-row__column-6
        = f.input :email,
                  disabled: current_account.suspended?,
                  input_html: { 'aria-label': t('simple_form.labels.defaults.email') },
                  required: true,
                  wrapper: :with_label
      .fields-row__column.fields-group.fields-row__column-6
        = f.input :current_password,
                  disabled: current_account.suspended?,
                  hint: false,
                  input_html: { 'aria-label': t('simple_form.labels.defaults.current_password'), autocomplete: 'current-password' },
                  required: true,
                  wrapper: :with_label

    .fields-row
      .fields-row__column.fields-group.fields-row__column-6
        = f.input :password,
                  disabled: current_account.suspended?,
                  hint: t('simple_form.hints.defaults.password'),
                  input_html: { 'aria-label': t('simple_form.labels.defaults.new_password'), autocomplete: 'new-password', minlength: User.password_length.first, maxlength: User.password_length.last },
                  label: t('simple_form.labels.defaults.new_password'),
                  wrapper: :with_label
      .fields-row__column.fields-group.fields-row__column-6
        = f.input :password_confirmation,
                  disabled: current_account.suspended?,
                  input_html: { 'aria-label': t('simple_form.labels.defaults.confirm_new_password'), autocomplete: 'new-password' },
                  label: t('simple_form.labels.defaults.confirm_new_password'),
                  wrapper: :with_label

  - elsif omniauth_only? && sso_account_settings.present?
    = link_to t('users.go_to_sso_account_settings'), sso_account_settings
  - else
    %p.hint= t('users.seamless_external_login')

%hr.spacer/

%h3= t('auth.security')

= render partial: 'sessions', object: @sessions

.muted-hint
  %ul
    %li= link_to t('settings.two_factor_authentication'), settings_two_factor_authentication_methods_path
    %li= link_to t('login_activities.title'), settings_login_activities_path
    %li= link_to t('settings.development'), settings_applications_path

- unless current_account.suspended? || self_destruct?
  %hr.spacer/

  %h3= t('auth.my_data')

  .muted-hint
    %ul
      %li= link_to t('settings.statuses_cleanup'), statuses_cleanup_path
      %li= link_to t('settings.export'), settings_export_path

  %p.muted-hint= t('auth.delete_account_html', path: settings_delete_path)
